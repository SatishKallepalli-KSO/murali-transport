# Public app URL
APP_URL=http://localhost:5175

# Required: strong admin PIN (8+ chars). Never use documented defaults in production.
ADMIN_PIN=

# Local-only fallback if ADMIN_PIN is empty (never set on Render)
# ALLOW_INSECURE_DEFAULT_PIN=1

# Comma-separated CORS origins (default *). For split hosting set explicit origins.
# CORS_ORIGINS=https://muralitransport.com

# Public write rate limit (loads / vehicles / bookings)
# PUBLIC_WRITE_MAX_ATTEMPTS=20
# PUBLIC_WRITE_WINDOW_SEC=3600

# Postgres — Neon Free pooled URL in production (see docs/DATABASE.md)
# Omit for local SQLite under apps/api/data/murali.db
# DATABASE_URL=postgresql://murali:PASS@ep-xxxx-pooler.region.aws.neon.tech/murali?sslmode=require
